<!DOCTYPE html>
<html>

<%- include('../partials/head.ejs') %>

<body>


    <%
    var pizzaPrice = 0;
    var extraPrice = 0;
    const PRIX_PIZZA = {
        "Pepperoni": 13.80,
        "All Dressed": 15.50,
        "Vegetarian": 14.30
    };

    const MULT_SIZE = {
        "Small": 0.8,
        "Medium": 1.0,
        "Large": 1.2
    };

    const PRIX_INGREDIENTS = 1.50;
    const TAX_RATE = 0.15;
    //C2 : beaucoup de chiffre magique, il serait préférable de les mettre dans des variables ou un objet pour plus de clarté et de maintenabilité

    pizzaPrice = PRIX_PIZZA[pizza];   
 
    pizzaPrice = pizzaPrice * MULT_SIZE[size];


    if (addIngredients.includes("Spicy Sausage")) {
        extraPrice = extraPrice + PRIX_INGREDIENTS;
    }

    if (addIngredients.includes("Extra Cheese")) {
        extraPrice = extraPrice + PRIX_INGREDIENTS;
    }

    if (addIngredients.includes("Italian Ham")) {
        extraPrice = extraPrice + PRIX_INGREDIENTS;
    }


    var subtotal = (pizzaPrice + extraPrice) * quantity;
    var taxes = subtotal * TAX_RATE;
    var total = subtotal + taxes;
%>

<h1>Order Summary</h1>
 
<p>Pizza: <%= pizza %></p>
<p>Size: <%= size %></p>
<p>Additional Ingredients: <%= addIngredients %></p>

<p>Price per pizza: $<%= pizzaPrice.toFixed(2) %></p>
<p>Quantity: <%= quantity %></p>
<p>Extra Ingredients Price: $<%= extraPrice.toFixed(2) %></p>

<hr>

<p>Subtotal: $<%= subtotal.toFixed(2) %></p>
<p>Taxes: $<%= taxes.toFixed(2) %></p>
<h2>Total: $<%= total.toFixed(2) %></h2>

<hr>

<h2>Customer Information</h2>

<p>Address: <%= address %></p>
<p>Postal Code: <%= postalCode %></p>
<p>Last Name: <%= lastName %></p>
<p>First Name: <%= firstName %></p>
<p>Phone Number: <%= phone %></p>
<p>Email: <%= email %></p>
<p>Payment Method: <%= payment %></p>

<br><br>

Return Home <a href="/">here</a> <br>

</body>

</html>